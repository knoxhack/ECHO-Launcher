{
  "name": "echo-launcher",
  "private": true,
  "version": "1.1.15",
  "description": "Official desktop launcher for ECHO experiences, PackOS catalogs, and public alpha builds.",
  "author": "knoxhack",
  "homepage": "https://github.com/knoxhack/ECHO-Launcher",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "desktop": "concurrently -k \"npm:dev\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "dev:chat": "npm run dev",
    "desktop:chat": "concurrently -k \"npm:dev\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "desktop:prod": "npm run build && electron .",
    "chat:dev": "npm --prefix server/community-chat run dev",
    "chat:install": "npm --prefix server/community-chat ci",
    "chat:test": "npm --prefix server/community-chat run test",
    "chat:build": "npm --prefix server/community-chat run build",
    "chat:check": "npm run chat:install && npm run chat:build && npm run chat:test",
    "chat:smoke": "npm --prefix server/community-chat run smoke",
    "chat:migrate": "npm --prefix server/community-chat run migrate",
    "pack:ashfall": "node scripts/pack-ashfall.mjs",
    "rc:mobile": "node scripts/mobile-rc-verify.mjs --run-checks",
    "rc:mobile:acceptance": "node scripts/mobile-rc-acceptance.mjs",
    "rc:mobile:device": "node scripts/mobile-rc-device-assist.mjs",
    "rc:mobile:package": "node scripts/mobile-rc-package.mjs",
    "rc:mobile:quick": "node scripts/mobile-rc-verify.mjs",
    "rc:mobile:ready": "node scripts/mobile-rc-ready.mjs",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "package:win": "npm run build && npm run perf:budget && npm run audit:placeholders && electron-builder --win nsis --publish never",
    "package:win:dir": "npm run build && npm run perf:budget && npm run audit:placeholders && electron-builder --win dir --publish never",
    "package:win:publish": "npm run build && npm run perf:budget && npm run audit:placeholders && electron-builder --win nsis --publish always",
    "package:linux": "npm run build && npm run perf:budget && npm run audit:placeholders && electron-builder --linux AppImage --publish never",
    "package:linux:dir": "npm run build && npm run perf:budget && npm run audit:placeholders && electron-builder --linux dir --publish never",
    "package:linux:publish": "npm run build && npm run perf:budget && npm run audit:placeholders && electron-builder --linux AppImage --publish always",
    "perf:budget": "node scripts/check-perf-budget.mjs",
    "audit:placeholders": "node scripts/check-placeholders.mjs",
    "test": "vitest run",
    "test:e2e:release-index": "node scripts/release-index-local-e2e.mjs",
    "test:e2e:sky-relay-launcher": "node scripts/sky-relay-launcher-lifecycle-smoke.mjs",
    "test:e2e:galactic-survey-launcher": "node scripts/galactic-survey-launcher-lifecycle-smoke.mjs",
    "test:e2e:official-pack-launcher": "node scripts/official-pack-launcher-lifecycle-smoke.mjs --clean",
    "test:e2e:ashfall-handoff-repair": "node scripts/all-modpacks-electron-install-smoke.mjs --clean --release-index-root ../ECHO-Release-Index --repair-handoff-fixture --pack ashfall-native-edition --pack ashfall-neoforge-edition --out ../ECHO-Release-Index/release-readiness/ashfall-electron-install-handoff-smoke.json",
    "test:e2e:sky-relay-electron-ui": "node scripts/sky-relay-electron-ui-smoke.mjs --clean",
    "test:e2e:galactic-survey-electron-ui": "node scripts/galactic-survey-electron-ui-smoke.mjs --clean",
    "test:e2e:all-modpacks-electron-install": "node scripts/all-modpacks-electron-install-smoke.mjs --clean",
    "test:e2e:all-native-modpacks-runtime-load": "node scripts/all-native-modpacks-runtime-load-smoke.mjs --clean",
    "test:e2e:ashfall-lane-game-smoke": "node scripts/ashfall-lane-game-smoke.mjs --strict",
    "audit:all-modpacks:pipeline": "node scripts/audit-all-modpacks-pipeline.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.13.26",
    "adm-zip": "^0.5.17",
    "electron-updater": "^6.8.3",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@types/node": "^24.12.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.5.0",
    "clsx": "^2.1.1",
    "concurrently": "^9.2.1",
    "electron": "^42.0.1",
    "electron-builder": "^26.8.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "jszip": "^3.10.1",
    "lucide-react": "^1.14.0",
    "postcss": "^8.5.14",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^3.4.17",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12",
    "vitest": "^4.1.6",
    "wait-on": "^9.0.10",
    "zustand": "^5.0.13"
  },
  "overrides": {
    "tmp": "^0.2.7"
  },
  "build": {
    "appId": "com.echo.launcher",
    "productName": "ECHO Launcher",
    "directories": {
      "output": "installer-artifacts"
    },
    "files": [
      "dist/**",
      "electron/**",
      "build/icon.ico",
      "build/icon.png",
      "build/installer.nsh",
      "package.json"
    ],
    "extraResources": [],
    "asarUnpack": [
      "build/icon.ico",
      "build/icon.png"
    ],
    "asar": true,
    "afterPack": "scripts/after-pack-win-icon.cjs",
    "win": {
      "target": [
        "nsis"
      ],
      "executableName": "ECHOLauncher",
      "signAndEditExecutable": false,
      "icon": "build/icon.ico",
      "artifactName": "ECHO-Launcher-${version}-Setup.${ext}"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "build/icon.png",
      "category": "Game",
      "artifactName": "ECHO-Launcher-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "ECHO Launcher",
      "uninstallDisplayName": "ECHO Launcher",
      "include": "build/installer.nsh",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "knoxhack",
        "repo": "ECHO-Launcher",
        "releaseType": "release"
      }
    ]
  }
}
